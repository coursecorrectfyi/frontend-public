# Copy to .env.local and fill in. Never commit .env.local.

# Backend API (the CourseCorrect backend; default dev port 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# NextAuth: session encryption secret (openssl rand -base64 32) and the site's base URL
NEXTAUTH_SECRET=YOUR_NEXTAUTH_SECRET_HERE
NEXTAUTH_URL=http://localhost:3001

# Google Tag Manager container ID (required at build time; any placeholder works locally)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Firebase web app config (Firebase console → Project settings → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: upstream host for the /blog reverse proxy (WordPress). Leave empty to disable.
NEXT_PUBLIC_HOSTINGER_IP=

# Optional: Google Form that collects early-access signups (formResponse URL + entry.* field IDs).
# Leave empty to skip submission in development.
NEXT_PUBLIC_EARLY_ACCESS_FORM_URL=
NEXT_PUBLIC_EARLY_ACCESS_INTENT_ENTRY_ID=
NEXT_PUBLIC_EARLY_ACCESS_EMAIL_ENTRY_ID=
