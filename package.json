{
  "name": "cc-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.14.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "DISABLE_ESLINT_PLUGIN=true next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true})\" && next typegen && tsc --noEmit",
    "verify": "scripts/verify.sh",
    "test:known-bugs": "node scripts/known-bugs.mjs",
    "test:mutations": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@mui/material-nextjs": "^6.3.1",
    "@tanstack/react-query": "^5.66.0",
    "firebase": "^12.9.0",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.3",
    "react-resizable-panels": "^3.0.2",
    "remark-gfm": "^4.0.0",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "jsdom": "^29.1.1",
    "msw": "^3.0.4",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
